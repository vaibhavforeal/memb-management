DATABASE_URL=postgresql://clubhouse:change-me@localhost:5432/clubhouse
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional Google sign-in alongside passwords; configure both to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Platform account: use test keys locally and live keys only on the production deployment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Independent secret configured for /api/webhooks/razorpay in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Required for file-share tokens in manual mode and credentials in cloud mode.
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=membrr <hello@example.com>
ALERT_EMAIL=
APP_DOMAIN=localhost
POSTGRES_PASSWORD=replace-with-random-hex-password
# External dead-man-switch monitor; configure missed-ping alerts in that service.
MONITOR_HEALTHCHECK_URL=
# Regular WhatsApp links; no automatic sends or messaging worker.
WHATSAPP_MODE=manual
# Used only by the optional cloud integration. Keep enabled during setup.
WHATSAPP_DRY_RUN=true
ALLOW_LOCAL_EMAIL_LOG=true

# Admin console (host-based routing). Production examples:
# CONSOLE_URL=https://console.membrr.pro
# CONSOLE_HOST=console.membrr.pro
# Dev: CONSOLE_URL=http://console.localhost:3000  CONSOLE_HOST=console.localhost:3000
CONSOLE_URL=
CONSOLE_HOST=

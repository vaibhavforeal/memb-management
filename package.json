{
  "name": "membrr-memberships",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build && tsx scripts/prepare-standalone.ts",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests e2e docs README.md *.ts *.json *.yaml *.mjs",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration-test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:backup": "tsx scripts/backup-test.ts",
    "test:worker": "tsx scripts/worker-test.ts",
    "test:manual": "tsx scripts/manual-whatsapp-test.ts",
    "test:directory": "tsx scripts/member-directory-test.ts",
    "test:reports": "tsx scripts/reports-test.ts",
    "test:qr": "tsx scripts/member-qr-test.ts",
    "test:files": "tsx scripts/shared-files-test.ts",
    "test:logo": "tsx scripts/business-logo-test.ts",
    "test:billing": "tsx scripts/business-billing-test.ts",
    "test:member-billing": "tsx scripts/member-billing-test.ts",
    "test:billing:e2e": "tsx scripts/browser-billing-test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "file-type": "^22.1.1",
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "nodemailer": "^10.0.13",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
